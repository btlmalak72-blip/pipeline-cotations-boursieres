    {
      "id": 30,
      "title": "Cotations par minute",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "questdb"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT event_time AS time, count() AS cotations FROM quotes WHERE event_time BETWEEN $__timeFrom() AND $__timeTo() SAMPLE BY 1m ALIGN TO CALENDAR"
        }
      ],
      "description": "Nombre de messages enregistrés chaque minute, tous symboles confondus.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 75
          }
        }
      }
    },
    {
      "id": 31,
      "title": "20 dernières cotations",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "questdb"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT event_time AS \"Heure\", cast(symbol AS varchar) AS \"Symbole\", price AS \"Prix USD\" FROM quotes WHERE event_time BETWEEN $__timeFrom() AND $__timeTo() ORDER BY event_time DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Prix USD"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      }
    },
    {
      "id": 40,
      "title": "Analyse des prix et état du flux",
      "type": "row",
