    {
      "id": 41,
      "title": "Chandeliers OHLC par minute",
      "type": "candlestick",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "questdb"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT event_time AS time, first(price) AS open, max(price) AS high, min(price) AS low, last(price) AS close FROM quotes WHERE symbol = ${action:sqlstring} AND event_time BETWEEN $__timeFrom() AND $__timeTo() SAMPLE BY 1m ALIGN TO CALENDAR"
        }
      ],
      "options": {
        "mode": "candles",
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "fields": {
          "open": "open",
          "high": "high",
          "low": "low",
          "close": "close"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "id": 42,
      "title": "Performance relative sur la période",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "questdb"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT event_time AS time, 100.0 * (price / baseline - 1.0) AS variation, cast(symbol AS varchar) AS metric FROM (SELECT event_time, symbol, price, first_value(price) OVER (PARTITION BY symbol ORDER BY event_time) AS baseline FROM quotes WHERE event_time BETWEEN $__timeFrom() AND $__timeTo()) ORDER BY event_time"
        }
      ],
      "description": "Chaque action commence à 0 % au premier prix de la période affichée.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 43,
      "title": "État du flux",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "questdb"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT CASE WHEN max(event_time) >= dateadd('s', -120, now()) THEN 1 ELSE 0 END AS etat FROM quotes"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "color": "green",
                  "text": "Actif"
                },
                "0": {
                  "color": "red",
                  "text": "En retard"
                }
              }
            }
          ],
          "noValue": "Indisponible",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 44,
      "title": "Dernière cotation reçue",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "questdb"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT cast(max(event_time) AS long) / 1000 AS derniere_cotation FROM quotes"
        }
      ],
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsLocal",
          "noValue": "Aucune cotation"
        }
      }
    },
    {
      "id": 45,
      "title": "Chandeliers calculés par Flink",
      "type": "candlestick",
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "questdb"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT window_start AS time, open_price AS open, high_price AS high, low_price AS low, close_price AS close FROM candles_flink WHERE symbol = ${action:sqlstring} AND window_start BETWEEN $__timeFrom() AND $__timeTo() ORDER BY window_start"
        }
      ],
      "options": {
        "mode": "candles",
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "fields": {
          "open": "open",
          "high": "high",
          "low": "low",
          "close": "close"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "description": "Fenêtres clôturées par Flink, publiées dans Redpanda, conservées dans Redis Streams et recopiées dans QuestDB pour Grafana."
    }
